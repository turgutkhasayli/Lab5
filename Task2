    <meta charset="UTF-8">
    <title>Məhsul Səhifəsi</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="konteyner">
        <div class="kart">
            <div class="sekil-sahəsi">
                <img src="Stranger-Things-5-Poster-Oficial-882x1024.jpg" alt="Məhsul">
                <button class="duyme">Click</button>
            </div>
            <div class="melumat">
                <span class="ad">Məhsul 1</span>
                <span class="qiymet">10 AZN</span>
            </div>
        </div>

        <div class="kart">
            <div class="sekil-sahəsi">
                <img src="wLQLTdvINL3U2Hs8vsBU8qE7HoB.webp" alt="Məhsul">
