CSS:

body {
    background-color: #e0e0e0;
    font-family: sans-serif;
    display: flex;
    justify-content: center;
    padding: 50px;
}

.konteyner {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;       
    max-width: 1000px;
}


.kart {
    background-color: white;
    padding: 10px;
    width: 280px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}


.sekil-sahəsi {
    position: relative; 
}

.sekil-sahəsi img {
    width: 100%;
    display: block;
}

.duyme {
    position: absolute;
    bottom: 5px;
    right: 5px;
    background-color: red;
    color: white;
    border: none;
    padding: 5px 15px;
    cursor: pointer;
    font-weight: bold;
}

.melumat {
    display: flex;
    justify-content: space-between; /* Adı sola, qiyməti sağa itələyir */
    padding-top: 15px;
    font-weight: bold;
}

.qiymet {
    color: green;
}
